# Copy this file to .env.local and fill in your real values.
# See README.md for exactly where to get each of these.

# Supabase project URL and anon (public) key — found in
# Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase SERVICE ROLE key — same page, "service_role" secret.
# NEVER expose this in the browser or commit it to a public repo.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# The password the shop owner will type in at /admin/login
ADMIN_PASSWORD=choose-a-strong-password

# Any long random string — used to sign the admin login session.
# You can generate one at https://generate-secret.vercel.app/32
ADMIN_SESSION_SECRET=replace-with-a-long-random-string
